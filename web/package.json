{
  "name": "@serega/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.13.0"
  },
  "scripts": {
    "dev": "vite",
    "generate": "openapi-typescript ../api/openapi.yaml --output src/shared/api/generated.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^7.0.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@tanstack/react-query": "^5.105.3",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-is": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
